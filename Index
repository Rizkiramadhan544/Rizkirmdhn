        #ffe2a3,
        #d99b42
    );

    color: #38200b;
    text-decoration: none;
    font-size: 15px;
    font-weight: bold;

    border: 2px solid #fff0c5;
    border-radius: 12px;

    box-shadow: 0 5px 12px rgba(0,0,0,0.3);

    transition: 0.3s;
}

.menu:hover {
    transform: translateY(-5px);
    background: linear-gradient(120deg,#fff0bd,#ffc857);
    box-shadow: 0 0 20px #ffc857;
}

.menu span:last-child {
    font-size: 23px;
}

/* FOOTER */
footer {
    color: #d6e4ff;
    font-size: 12px;
    margin-top: 28px;
    line-height: 1.8;
}

footer strong {
    color: #ffc857;
}

/* HP */
@media(max-width:480px) {
    .container {
        padding: 28px 18px;
    }

    h1 {
        font-size: 25px;
    }

    .nama {
